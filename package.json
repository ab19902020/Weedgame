{
 "name": "green-county-berkshire",
 "version": "0.43.0",
 "private": true,
 "scripts": {
  "build": "node tools/build.mjs",
  "dev": "node tools/build.mjs --dev --watch",
  "serve": "python3 -m http.server 8080 --directory www",
  "world": "python3 tools/pipeline/build_world.py data www/world && python3 tools/pipeline/fit_ll.py www/world && python3 tools/pipeline/canopies.py data www/world",
  "apk": "bash tools/android/build.sh",
  "acceptance": "node tools/test/acceptance.js docs/captures",
  "test": "node --no-warnings --test 'tools/test/unit/*.test.mjs'",
  "acceptance:quick": "ONLY=${ONLY:-collision,signal,flythrough,traffic persists,mission} xvfb-run -a node tools/test/acceptance.js ${QUICK_OUT:-/tmp/acceptance-quick}",
  "test:police": "xvfb-run -a node tools/test/police.js",
  "test:play": "node tools/test/playability.mjs",
  "test:wanted": "node tools/test/wanted.mjs /tmp",
  "rail": "node --no-warnings tools/rail/build_rail.mjs",
  "stops": "node --no-warnings tools/roads/stops.mjs",
  "audit:roads": "ROAD_SURFACE=1 ROAD_REPORT=road-audit.json node tools/test/workerAudit.mjs"
 },
 "devDependencies": {
  "esbuild": "0.25.10",
  "playwright": "^1.65.1"
 },
 "dependencies": {
  "three": "0.186.1"
 }
}
